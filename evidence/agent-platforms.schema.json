{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/md2wechat/md2wechat-wiki/raw/main/evidence/agent-platforms.schema.json",
  "title": "md2wechat office Agent platform evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewedAt", "platforms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviewedAt": { "type": "string", "format": "date" },
    "platforms": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/platform" }
    }
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "vendor", "officialUrl", "evidenceUrls",
        "md2wechatStatus", "publiclySupported", "reviewedAt",
        "expiresAfterDays", "invalidationConditions", "nextSmoke", "evidenceNote"
      ],
      "properties": {
        "id": { "enum": ["qwenwork", "dumate", "workbuddy", "doubao-work"] },
        "name": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "officialUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "evidenceUrls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "md2wechatStatus": {
          "enum": ["verified", "compatible", "install-ready", "smoke-pending", "unsupported", "review-due"]
        },
        "publiclySupported": { "type": "boolean" },
        "reviewedAt": { "type": "string", "format": "date" },
        "expiresAfterDays": { "type": "integer", "minimum": 1 },
        "invalidationConditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "nextSmoke": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceNote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
